# 服务
APP_HOST=0.0.0.0
APP_PORT=8000
# 相对路径按代码目录解析；生产建议绝对路径，如 /var/lib/corefix
DATA_DIR=./data

# 模型后端：llama（默认）或 fake（离线预览）
# MODEL_BACKEND=fake

# llama.cpp（同机）
MODEL_ROOT_URL=http://127.0.0.1:8080
MODEL_BASE_URL=http://127.0.0.1:8080/v1
MODEL_ALIAS=qwen3.5-9b
MODEL_TIMEOUT_SECONDS=300
MODEL_ENABLE_THINKING=false
MODEL_JSON_MODE=auto

# 采样
MODEL_TEMPERATURE_TRANSLATE=0.25
MODEL_TOP_P=0.9
MODEL_TOP_K=20
MODEL_REPEAT_PENALTY=1.05
MODEL_SEED=42
MODEL_TEMPERATURE_CHAT=0.7

# 批预算
TRANSLATION_MAX_OUTPUT_TOKENS=6144
TRANSLATION_TARGET_OUTPUT_TOKENS=2500
TRANSLATION_TOKEN_EXPANSION=1.3
PROMPT_OVERHEAD_TOKENS=800
TRANSLATION_MAX_UNITS_PER_BATCH=40

# 上传
MAX_UPLOAD_SIZE_MB=100

# PDF 导出（DOCX 转 PDF 需要 LibreOffice）
# SOFFICE_BIN=/usr/bin/soffice
# overlay=原位替换文本（默认，保留版式，不需要 LibreOffice）
# reflow=重建 DOCX 再转 PDF（需要 LibreOffice）
PDF_OUTPUT_MODE=overlay
PDF_FONT_NAME=Noto Sans CJK SC
PDF_CONVERT_TIMEOUT_SECONDS=300

# 聊天
CHAT_CONTEXT_RATIO=0.6
CHAT_MAX_HISTORY_TURNS=20
CHAT_MAX_OUTPUT_TOKENS=2048
CHAT_ATTACHMENT_MAX_CHARS=8000
CHAT_ATTACHMENT_TOTAL_CHARS=16000
